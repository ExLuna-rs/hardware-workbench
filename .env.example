# Copie ce fichier en .env et adapte.

# Mot de passe de l'interface KiCad dans le navigateur (noVNC)
VNC_PASSWORD=change-moi

# Jeton du serveur MCP et du viewer (générer : openssl rand -hex 32).
# Vide = aucune auth : à réserver à un usage strictement local.
MCP_TOKEN=

# Adresse d'écoute des ports publiés : 127.0.0.1 (local), IP LAN/VPN d'apollo, ou 0.0.0.0
BIND_ADDR=127.0.0.1

# URL à laquelle tu ouvres le viewer (renvoyée par Claude dans ses réponses)
ATELIER_PUBLIC_URL=http://apollo.lan:8000

# Projet ouvert au démarrage de KiCad (chemin dans le conteneur), optionnel
KICAD_PROJECT=

# 1 = modèles 3D KiCad installés (export STEP complet, plusieurs Go) ; 0 = sans
WITH_3D_MODELS=1

RESOLUTION=1920x1080
